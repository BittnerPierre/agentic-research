##
## vLLM mono-model: Mistral-Small-4-119B-NVFP4 (WS1 control loop)
##
## Used by docker-compose.dgx-vllm-mistral-small4-mono.yml (to be added).
## Embeddings stay on llama.cpp (unchanged).
##
## Purpose: control experiment vs gpt-oss-20b/120b on vLLM Responses.
## Mistral-Small-4 is MoE + reasoning + instruct — different family from
## gpt-oss, isolates whether the Harmony/channel-leak class of bugs is
## gpt-oss-specific or vLLM-wide on Responses.
##
## DGX Spark / GB10 / sm_121 spécifique :
##   - MLA standard rejette head_size=320 (FlashAttn, XFormers).
##   - TRITON_MLA crashe (shape mismatch 256/512 dans kernel grouped decode).
##   - Image officielle Mistral (mistralllm/vllm-ms4:latest) = x86_64 only.
## → Solution: image avarok aarch64 + désactivation MLA + GEMM marlin.
##   Source: https://forums.developer.nvidia.com/t/363863
##

MODELS_DIR=${HOME}/.cache/huggingface/hub
HF_HOME=${HOME}/.cache/huggingface

# Image custom = rebuild local de avarok/dgx-vllm-nvfp4-kernel:v23 + mistral_common>=1.10.0
# (requis pour tekken.json v15 du modèle Mistral-Small-4). L'image base avarok ships
# avec mistral_common qui ne reconnaît que jusqu'à v13 — crash au démarrage sur tokenizer.
# Rebuild Dockerfile (dans ~/avarok-mistral-small4) :
#   FROM avarok/dgx-vllm-nvfp4-kernel:v23
#   RUN /opt/venv/bin/pip install --upgrade mistral_common
# Build : docker build -t avarok-mistral-small4:v1 ~/avarok-mistral-small4/
VLLM_IMAGE=avarok-mistral-small4:v1
VLLM_MODEL=mistralai/Mistral-Small-4-119B-2603-NVFP4
VLLM_SERVED_MODEL_NAME=mistral-small-4-119b
VLLM_PORT=8002
# Cap KV cache : 40K (forum) overshoot la mémoire dispo (21.31 GiB vs
# 21.97 GiB requis à 40K). Effectif validé 2026-05-11 = 32K @ 0.75 util.
# Iso avec gpt-oss-20b/120b baselines → comparaisons control loop propres.
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.75
VLLM_TOOL_CALL_PARSER=mistral
VLLM_REASONING_PARSER=mistral
# Extra flags passés au binaire vllm (en plus des flags posés par le compose).
VLLM_EXTRA_PARAMS=

# Env vars sm_121 spécifiques — à propager via `environment:` dans le compose.
# Sans ces 5 variables, le démarrage crashe sur kernel/MLA.
VLLM_MLA_DISABLE=1
VLLM_NVFP4_GEMM_BACKEND=marlin
VLLM_USE_FLASHINFER_MOE_FP4=0
VLLM_TEST_FORCE_FP8_MARLIN=1
VLLM_ENGINE_CORE_STARTUP_TIMEOUT=300

# Embeddings (unchanged, llama.cpp)
EMBEDDINGS_MODEL_PATH=/mnt/models/models--Qwen--Qwen3-Embedding-4B-GGUF/snapshots/f4602530db1d980e16da9d7d3a70294cf5c190be/Qwen3-Embedding-4B-Q8_0.gguf
EMBEDDINGS_PORT=8003
EMBEDDINGS_EXTRA_PARAMS=

# For download helper scripts
EMBEDDINGS_MODEL_REPO=Qwen/Qwen3-Embedding-4B-GGUF
EMBEDDINGS_GGUF_PATTERN=Qwen3-Embedding-4B-Q8_0.gguf
