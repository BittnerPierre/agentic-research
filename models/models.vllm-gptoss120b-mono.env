##
## vLLM mono-model: gpt-oss-120B (WS1)
##
## Used by docker-compose.dgx-vllm-mono.yml.
## Embeddings stay on llama.cpp (unchanged).
##
## TODO(spark-spike): validate on DGX Spark (aarch64 / GB10 Blackwell):
##   - VLLM_IMAGE needs a Blackwell/ARM64-compatible build
##     (see https://github.com/eugr/spark-vllm-docker)
##   - VLLM_REASONING_PARSER: confirm the exact parser name for gpt-oss
##   - VLLM_MAX_MODEL_LEN / GPU_MEMORY_UTILIZATION: tune to fit 128GB unified mem
##

MODELS_DIR=${HOME}/.cache/huggingface/hub
HF_HOME=${HOME}/.cache/huggingface

# vLLM service
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=openai/gpt-oss-120b
VLLM_SERVED_MODEL_NAME=gpt-oss-120b
VLLM_PORT=8002
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_REASONING_PARSER=openai_gptoss
# Extra flags appended verbatim (e.g. "--enforce-eager --swap-space 4")
VLLM_EXTRA_PARAMS=

# Embeddings (unchanged, llama.cpp)
EMBEDDINGS_MODEL_PATH=/mnt/models/models--Qwen--Qwen3-Embedding-4B-GGUF/snapshots/f4602530db1d980e16da9d7d3a70294cf5c190be/Qwen3-Embedding-4B-Q8_0.gguf
EMBEDDINGS_PORT=8003
EMBEDDINGS_EXTRA_PARAMS=

# For download helper scripts
EMBEDDINGS_MODEL_REPO=Qwen/Qwen3-Embedding-4B-GGUF
EMBEDDINGS_GGUF_PATTERN=Qwen3-Embedding-4B-Q8_0.gguf
