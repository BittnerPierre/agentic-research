##
## vLLM mono-model: gpt-oss-20b (WS1 step 4')
##
## Used by docker-compose.dgx-vllm-gptoss20b-mono.yml.
## Embeddings stay on llama.cpp (unchanged).
##
## Defaults below are spike-validated on DGX Spark solo (2026-04-17).
## See docs/ws1/WS1_STUDY_NOTES.md §3 for the validation log.
##
## Note: do NOT set VLLM_USE_FLASHINFER_MOE_MXFP4_MXFP8 with the standard
## vllm-node image — the FLASHINFER_TRTLLM_MXFP4_MXFP8 MoE backend is
## unsupported on GB10 / sm_121. That env var is only valid on the
## --exp-mxfp4 build (vllm-node-mxfp4 image, not used here).
##

MODELS_DIR=${HOME}/.cache/huggingface/hub
HF_HOME=${HOME}/.cache/huggingface

# vLLM service — local eugr build (~/spark-vllm-docker), validated 2026-04-20
# end-to-end with the canonical gpt-oss flag combo (commit 269be4c).
#
# DO NOT use nvcr.io/nvidia/vllm:26.03.post1-py3 (NVIDIA NGC official Spark
# build): with the same canonical flags, NGC leaks the Harmony channel marker
# (<|channel|>commentary) inside tool-call names, breaking agentic-research
# (ModelBehaviorError "Tool fetch_vector_store_name<|channel|>commentary not
# found in agent ..."). eugr's vLLM build strips the marker correctly.
# Confirmed 2026-04-30 on DGX Spark / query_advanced_1.md.
# Setup config consumed by dataprep + agentic-research containers.
SETUP_CONFIG=configs/config-docker-dgx-vllm-gptoss20b-mono.yaml

VLLM_IMAGE=vllm-node:latest
VLLM_MODEL=openai/gpt-oss-20b
VLLM_SERVED_MODEL_NAME=gpt-oss-20b
VLLM_PORT=8002
VLLM_MAX_MODEL_LEN=65536
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_TOOL_CALL_PARSER=openai
VLLM_REASONING_PARSER=openai_gptoss
# Canonical gpt-oss flag combo (community-sourced, validated end-to-end on
# DGX Spark 2026-04-20). --async-scheduling improves throughput;
# --default-chat-template-kwargs forces reasoning_effort=low at template
# rendering time to match the llama.cpp instruct profile.
VLLM_EXTRA_FLAGS=--async-scheduling --default-chat-template-kwargs={"reasoning_effort":"low"}

# Embeddings (unchanged, llama.cpp)
EMBEDDINGS_MODEL_PATH=/mnt/models/models--Qwen--Qwen3-Embedding-4B-GGUF/snapshots/f4602530db1d980e16da9d7d3a70294cf5c190be/Qwen3-Embedding-4B-Q8_0.gguf
EMBEDDINGS_PORT=8003
EMBEDDINGS_EXTRA_PARAMS=

# For download helper scripts
EMBEDDINGS_MODEL_REPO=Qwen/Qwen3-Embedding-4B-GGUF
EMBEDDINGS_GGUF_PATTERN=Qwen3-Embedding-4B-Q8_0.gguf
